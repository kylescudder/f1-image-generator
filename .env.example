PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data

# Clerk dashboard: use the same instance for both keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact immutable Clerk user ID for Kyle. No owner configured = all admin access denied.
CLERK_OWNER_USER_ID=

# Server-only OpenRouter key. Model is chosen in the owner's Settings screen.
OPENROUTER_API_KEY=

# Emby connects from Herman. API key stays server-side.
EMBY_URL=
EMBY_API_KEY=

# Herman uses the existing platform Tunnel/Caddy network; see deploy/README.md.
PADDOCK_DATA_DIR=./data
# Set by the verified deployer, not to a mutable tag.
PADDOCK_IMAGE=
