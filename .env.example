PORT=3000
APP_URL=http://localhost:3000
# Generated backgrounds, cached renders and fonts. State itself lives in PostgreSQL.
DATA_DIR=./data

# Local development database (see README). Herman uses DATABASE_PASSWORD_FILE instead of a password in the URL.
DATABASE_URL=postgres://postgres:paddock@127.0.0.1:55432/paddock_dev

# Clerk dashboard: use the same instance for both keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-only OpenRouter key. Model is chosen in the owner's Settings screen.
OPENROUTER_API_KEY=

# Emby connects from Herman. API key stays server-side.
EMBY_URL=
EMBY_API_KEY=

# Herman uses the existing platform Tunnel/Caddy network; see deploy/README.md.
PADDOCK_DATA_DIR=./data
# Set by the verified deployer, not to a mutable tag.
PADDOCK_IMAGE=
